# Copy to .env locally or configure these as environment variables on the host.
# Never commit real credentials.
PORT=3000
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
YAR_DATA_FILE=./data.json
# Optional: comma-separated allowed browser origins for the web prototype.
CORS_ORIGIN=
